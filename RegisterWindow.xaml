<Window x:Class="WpfApp1.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація" Height="300" Width="350" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Реєстрація акаунта" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="Логін:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" Margin="0,0,0,20"/>

            <Button Content="Зареєструватися" Height="35" Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="BtnRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>