<Window x:Class="WpfApp1.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація" Height="680" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F0F4F8" Margin="20">
        <StackPanel>
            <TextBlock Text="Реєстрація" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Label Content="Логін *"/>
            <TextBox x:Name="txtRegLogin" Height="25"/>

            <Label Content="Пароль *"/>
            <PasswordBox x:Name="txtRegPassword" Height="25"/>

            <Label Content="Повторіть пароль *"/>
            <PasswordBox x:Name="txtRegConfirmPassword" Height="25"/>

            <Button Content="Зареєструватися" Click="BtnRegister_Click" Height="35" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>