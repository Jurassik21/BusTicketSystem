<Window x:Class="WpfApp1.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель Адміністратора" Height="500" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управління маршрутами" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <ListView Name="lvAdminRoutes" Grid.Row="1" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Звідки" DisplayMemberBinding="{Binding DepartureCity}" Width="150"/>
                    <GridViewColumn Header="Куди" DisplayMemberBinding="{Binding ArrivalCity}" Width="150"/>
                    <GridViewColumn Header="Час" DisplayMemberBinding="{Binding DepartureTime}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <!-- Блок управління маршрутами -->
            <TextBlock Text="Додати маршрут:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBox Name="txtDepCity" Width="120" Margin="0,0,10,0" ToolTip="Звідки"/>
                <TextBox Name="txtArrCity" Width="120" Margin="0,0,10,0" ToolTip="Куди"/>
                <TextBox Name="txtTime" Width="150" Margin="0,0,10,0" ToolTip="Час (наприклад: 2026-11-01 10:00)"/>
                <Button Name="btnAddRoute" Content="Додати маршрут" Width="120" Click="BtnAddRoute_Click"/>
            </StackPanel>
            <Button Name="btnDeleteRoute" Content="Видалити вибраний маршрут" Background="Salmon" Height="30" Margin="0,0,0,15" Click="BtnDeleteRoute_Click"/>

            <!-- НОВИЙ БЛОК: Управління користувачами -->
            <TextBlock Text="Видалити користувача:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Name="txtUsernameToDelete" Width="200" Margin="0,0,10,0" ToolTip="Введіть логін користувача"/>
                <Button Name="btnDeleteUser" Content="Видалити" Background="Salmon" Width="100" Click="BtnDeleteUser_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>