<Window x:Class="WpfApp1.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель адміністратора" Height="680" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="15" Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Панель адміністратора" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Панель додавання маршруту -->
        <Border Grid.Row="1" Background="White" Margin="0,0,0,15" Padding="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Додати новий маршрут" FontWeight="Bold" Margin="0,0,0,10"/>

                <Label Content="Місто відправлення:"/>
                <TextBox x:Name="txtDeparture" Height="25" Margin="0,0,0,5"/>

                <Label Content="Місто прибуття:"/>
                <TextBox x:Name="txtArrival" Height="25" Margin="0,0,0,5"/>

                <Label Content="Дата та час:"/>
                <TextBox x:Name="txtTime" Height="25" Text="2026-10-15 09:00" Margin="0,0,0,10"/>

                <Button Content="Додати маршрут" Click="BtnAddRoute_Click" Height="35" Background="#28A745" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Список поточних маршрутів -->
        <ListView x:Name="lvAdminRoutes" Grid.Row="2" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Звідки" Width="110" DisplayMemberBinding="{Binding DepartureCity}"/>
                    <GridViewColumn Header="Куди" Width="110" DisplayMemberBinding="{Binding ArrivalCity}"/>
                    <GridViewColumn Header="Час" Width="130" DisplayMemberBinding="{Binding DepartureTime}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Кнопка видалення обраного маршруту -->
        <Button Grid.Row="3" Content="Видалити обраний маршрут" Click="BtnDeleteRoute_Click" Height="35" Margin="0,0,0,10" Background="#FFC107" Foreground="Black" FontWeight="Bold"/>

        <!-- Кнопка виходу -->
        <Button Grid.Row="4" Content="Вийти з акаунта" Click="BtnLogout_Click" Height="35" Background="#DC3545" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>