<Window x:Class="WpfApp1.RouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вибір маршруту" Height="720" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="15" Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Доступні маршрути" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Вибір дати за допомогою календаря -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Label Content="Оберіть дату поїздки:" FontWeight="SemiBold"/>
            <DatePicker x:Name="dpTravelDate" Height="30" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Велика синя кнопка -->
        <Button Grid.Row="2" Content="Показати доступні рейси" Click="BtnSearch_Click" Height="40" Margin="0,0,0,15" Background="#007ACC" Foreground="White" FontWeight="Bold"/>

        <!-- Список маршрутів -->
        <ListView x:Name="lvRoutes" Grid.Row="3" SelectionChanged="LvRoutes_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Звідки" Width="100" DisplayMemberBinding="{Binding DepartureCity}"/>
                    <GridViewColumn Header="Куди" Width="100" DisplayMemberBinding="{Binding ArrivalCity}"/>
                    <GridViewColumn Header="Час" Width="135" DisplayMemberBinding="{Binding DepartureTime}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>